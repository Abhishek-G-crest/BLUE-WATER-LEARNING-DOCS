flowchart TD
  DOC[Segregated document PDF]
  TYP[document type label]
  MAP["return_ExtractFunctions()"]
  N["Note → note()"]
  CD["Closing_Disclosure → extractCD()"]
  CR["Credit_Report → CreditReport()"]
  SI["Security_Instrument → extractDot()"]
