    ENRICH["??????????????????????????????<br/>??? UNKNOWN ENRICHMENT ???<br/>??? KT CONFIRMATION REQUIRED ???<br/>adds loan_id / deal_id / porfolio_id?<br/>??????????????????????????????"]
  end

  subgraph ST["SUPER TRANSFER WORKER"]
    MAIN["scripts/main.py<br/>receive_message"]
