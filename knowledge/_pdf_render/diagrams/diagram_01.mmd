    PL["processLoan<br/>process_loan_handler.py"]
    SEG["segregate_documents<br/>classify_label"]
    EXT["return_ExtractFunctions<br/>extractors"]
  end

  subgraph DD["DUE DILIGENCE"]
    DDAPI["HTTP /msrx/duediligence/...<br/>send_values_to_DD"]
  end

